<symbol id="profile_image" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
    <circle r="16" cy="16" cx="16" fill="{{ background_color }}" />
    <text
        x="50%"
        y="50%"
        dominant-baseline="central"
        text-anchor="middle"
        font-family="Mulish, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
        font-size="16px"
        font-weight="600"
        fill="{{ text_color }}"
    >
        {{ initials }}
    </text>
</symbol>
